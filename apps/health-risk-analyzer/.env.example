# Required: Anthropic API key for Claude
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: model override (default: claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# Optional: Lumin MCP URL override (default: https://mcp.lumin.guru/mcp)
# Use the authless endpoint /mcp (50 calls/day per IP) for demos.
# Switch to /mcp/auth + LUMIN_API_KEY for production traffic.
# LUMIN_MCP_URL=https://mcp.lumin.guru/mcp
# LUMIN_API_KEY=mcp_...
