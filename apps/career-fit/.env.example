# Your Anthropic key. The model bill is yours.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# This app runs 15 to 18 tool calls per reading (more with paging), so the
# default model is the right choice; do not swap to a cheaper model to save
# cost, swap the horizon or the tool list instead.
ANTHROPIC_MODEL=claude-opus-5

# Required. Every Lumin endpoint needs credentials; there is no anonymous access.
# Create a key at https://app.lumin.guru/developer
LUMIN_API_KEY=mcp_...

# Optional. Defaults to https://mcp.lumin.guru/mcp
# API keys go to /mcp. The /mcp/auth endpoint is OAuth-only and rejects API keys.
LUMIN_MCP_URL=https://mcp.lumin.guru/mcp
