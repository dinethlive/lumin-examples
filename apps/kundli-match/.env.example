# Your Anthropic key. You pay the model bill.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. The default is claude-opus-5-5.
# This app runs 11 tool calls and reasons across systems for two charts. So the
# default is worth keeping. claude-sonnet-5-5 is the cheaper option if you need
# it. With it, expect a shallower disagreement drawer.
ANTHROPIC_MODEL=claude-opus-5-5

# Required. Every Lumin endpoint needs credentials. There is no anonymous access.
# Create a key at https://app.lumin.guru/api-keys
LUMIN_API_KEY=mcp_...

# Optional. The default is https://mcp.lumin.guru/mcp
# API keys go to /mcp. The /mcp/auth endpoint is OAuth only and rejects API keys.
LUMIN_MCP_URL=https://mcp.lumin.guru/mcp
