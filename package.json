{
  "name": "lumin-examples",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source example apps built on the Lumin MCP server",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter '*' build",
    "check:tools": "bun scripts/check-tool-names.mjs"
  },
  "packageManager": "bun@1.3.10"
}
